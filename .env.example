# Copy to .env for local development. Never commit real values.
# Production values are set in the Render dashboard (see render.yaml and docs/DEPLOYMENT.md).

# development | production | test
APP_ENV=development
# The URL users open. Used for Google's OAuth callback and the cross-site request check.
# With the Vite dev server use http://localhost:5173; with the built frontend use http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:5173
# Development only: shows "Continue as local developer" on the sign-in page. Refused in production.
DEV_LOGIN_ENABLED=true

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=paperchat
REDIS_URL=redis://localhost:6379/0

# local (development) | s3 (production — required, because web and worker run on separate machines)
STORAGE_BACKEND=local
# UPLOAD_DIR=.runtime/uploads
# S3_BUCKET=
# S3_ENDPOINT_URL=          # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# At least 32 random characters in production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=
# Google OAuth web client. Authorised redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enables generated answers. Without it, the most relevant passages are returned.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=45
# OPENAI_MAX_OUTPUT_TOKENS=800

# Limits (defaults shown)
# MAX_UPLOAD_MB=25
# MAX_PAGES=500
# WORKER_TIMEOUT_SECONDS=300
# USER_MAX_DOCUMENTS=50
# RATE_LIMIT_QUESTIONS_PER_MINUTE=20
# RATE_LIMIT_QUESTIONS_PER_DAY=300
# RATE_LIMIT_UPLOADS_PER_HOUR=20

# Only if the frontend is ever served from a different origin than the API (not needed on Render).
# CORS_ORIGINS=

# LOG_LEVEL=INFO
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1
