# Copy to .env for local development. Never commit real values.
# Production values are set in the Render dashboard (see render.yaml and docs/DEPLOYMENT.md).

# development | production | test
APP_ENV=development
# The URL users open. Used for Google's OAuth callback and the cross-site request check.
# With the Vite dev server use http://localhost:5173; with the built frontend use http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:5173
# Development only: shows "Continue as local developer" on the sign-in page. Refused in production.
DEV_LOGIN_ENABLED=true

MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=paperchat
REDIS_URL=redis://localhost:6379/0

# local (development) | s3 (production — required, because web and worker run on separate machines)
STORAGE_BACKEND=local
# UPLOAD_DIR=.runtime/uploads
# S3_BUCKET=
# S3_ENDPOINT_URL=          # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# At least 32 random characters in production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=
# Google OAuth web client. Authorised redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider (any OpenAI-compatible API). Required for AI answers, and in production.
# Without a key (development only) retrieval falls back to keyword search and returns passages instead of answers.
# Changing the embedding model or EMBEDDING_DIMENSIONS means re-uploading existing documents.
#
# Google Gemini (free tier: key from https://aistudio.google.com/apikey):
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=2048
#
# OpenAI instead: leave AI_BASE_URL empty and use e.g.
#   AI_CHAT_MODEL=gpt-4.1-mini  AI_EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIMENSIONS=1024
#   and remove AI_REASONING_EFFORT (gpt-4.1 models reject it).
# AI_TIMEOUT_SECONDS=45
# RETRIEVAL_TOP_K=6

# Local cross-encoder reranking (~110 MB of memory, no API calls). Measured in eval/README.md:
# it improves keyword-only retrieval but ranks worse than the embedding model, so it runs only when
# a document has no usable embeddings. Options: lexical-only (default), always, never.
# RERANK_MODE=lexical-only
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20
# MODEL_CACHE_DIR=.runtime/models

# Limits (defaults shown)
# MAX_UPLOAD_MB=25
# MAX_PAGES=500
# WORKER_TIMEOUT_SECONDS=300
# USER_MAX_DOCUMENTS=50
# RATE_LIMIT_SEARCHES_PER_MINUTE=60
# RATE_LIMIT_SUMMARIES_PER_HOUR=10
# RATE_LIMIT_QUESTIONS_PER_MINUTE=20
# RATE_LIMIT_QUESTIONS_PER_DAY=300
# RATE_LIMIT_UPLOADS_PER_HOUR=20

# Only if the frontend is ever served from a different origin than the API (not needed on Render).
# CORS_ORIGINS=

# Run the document worker inside the web process instead of as a separate service
# (used on hosts whose free tier has no background workers).
# RUN_WORKER_IN_WEB=false

# LOG_LEVEL=INFO
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1
